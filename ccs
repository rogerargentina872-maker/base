<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Organizador con Selector Fijo</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    textarea { width: 100%; height: 200px; }
    button { margin-top: 10px; padding: 10px 15px; }
    input { margin-top: 20px; padding: 8px; width: 50%; }
    table { margin-top: 20px; border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    tr.hide { display: none; }
    td.seleccionada { outline: 2px solid blue; }

    /* Caja flotante para el selector */
    #colorBox {
      position: fixed;
      top: 20px;
      right: 20px;
      background: #f9f9f9;
      border: 1px solid #ccc;
      padding: 10px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>
  <h1>Organizador de Información</h1>
  <p>Pega tu información en el cuadro de texto y se organizará en una tabla.</p>
  
  <textarea id="entrada" placeholder="Pega aquí tus registros..."></textarea>
  <br>
  <button onclick="organizar()">Organizar</button>
  
  <!-- Buscador -->
  <input type="text" id="buscador" placeholder="Buscar en la tabla..." onkeyup="filtrarTabla()">
  
  <div id="resultado"></div>

  <!-- Selector de color fijo -->
  <div id="colorBox">
    <label for="colorSelect">Color de fondo:</label><br>
    <select id="colorSelect" onchange="cambiarColor()">
      <option value="white">Blanco</option>
      <option value="lightgreen">Verde</option>
      <option value="lightcoral">Rojo</option>
      <option value="lightsalmon">Naranja</option>
    </select>
    <p style="font-size:12px;">👉 Selecciona una celda y luego elige el color.</p>
  </div>

  <script>
    function organizar() {
      const texto = document.getElementById("entrada").value.trim();
      const resultadoDiv = document.getElementById("resultado");
      resultadoDiv.innerHTML = "";

      if (!texto) {
        resultadoDiv.innerHTML = "No se ingresó información.";
        return;
      }

      const lineas = texto.split("\n");

      let tabla = "<table id='tabla'><thead><tr>" +
        "<th>Número</th><th>Mes</th><th>Año</th><th>Código</th>" +
        "<th>Nombre</th><th>ID</th><th>Dirección</th><th>Teléfono</th>" +
        "<th>Marca</th><th>Tipo</th><th>Banco</th><th>Clase</th><th>País</th>" +
        "</tr></thead><tbody>";

      lineas.forEach(linea => {
        const campos = linea.split("|");
        tabla += "<tr>";
        campos.forEach(campo => {
          tabla += `<td>${campo.trim() || "-"}</td>`;
        });
        tabla += "</tr>";
      });

      tabla += "</tbody></table>";
      resultadoDiv.innerHTML = tabla;

      // Permitir seleccionar celdas
      document.querySelectorAll("#tabla td").forEach(td => {
        td.addEventListener("click", function() {
          document.querySelectorAll("#tabla td").forEach(c => c.classList.remove("seleccionada"));
          this.classList.add("seleccionada");
          window.celdaSeleccionada = this;
        });
      });
    }

    function filtrarTabla() {
      const filtro = document.getElementById("buscador").value.toLowerCase();
      const filas = document.querySelectorAll("#tabla tbody tr");

      filas.forEach(fila => {
        const textoFila = fila.textContent.toLowerCase();
        if (textoFila.includes(filtro)) {
          fila.classList.remove("hide");
        } else {
          fila.classList.add("hide");
        }
      });
    }

    function cambiarColor() {
      if (window.celdaSeleccionada) {
        const color = document.getElementById("colorSelect").value;
        window.celdaSeleccionada.style.backgroundColor = color;
      } else {
        alert("Primero selecciona una celda de la tabla.");
      }
    }
  </script>
</body>
</html>
